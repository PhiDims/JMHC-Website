// Cloudflare Worker settings for josmhconference.com
{
  "name": "jmhc-website",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "keep_vars": true,
  // Both addresses serve the site. Cloudflare attaches them on every deploy.
  "routes": [
    { "pattern": "josmhconference.com", "custom_domain": true },
    { "pattern": "www.josmhconference.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
